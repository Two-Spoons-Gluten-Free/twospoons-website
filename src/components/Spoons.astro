---
interface Props { class?: string; faces?: boolean }
const { class: className = '', faces = false } = Astro.props;
---
<svg class={className} viewBox="0 0 120 145" fill="none" aria-hidden="true">
  <g transform="rotate(-15 36 70)"><ellipse cx="36" cy="33" rx="21" ry="29" fill="currentColor" /><path d="M36 54v76" stroke="currentColor" stroke-width="13" stroke-linecap="round" />{faces && <><path d="M26 36q10 12 20 0" stroke="var(--cream)" stroke-width="2.5" stroke-linecap="round"/><circle cx="29" cy="26" r="2" fill="var(--cream)"/><circle cx="43" cy="26" r="2" fill="var(--cream)"/></>}</g>
  <g transform="rotate(17 87 83)"><ellipse cx="87" cy="55" rx="17" ry="24" fill="currentColor"/><path d="M87 73v61" stroke="currentColor" stroke-width="11" stroke-linecap="round"/>{faces && <><path d="M79 58q8 9 16 0" stroke="var(--cream)" stroke-width="2.3" stroke-linecap="round"/><circle cx="81" cy="49" r="1.8" fill="var(--cream)"/><circle cx="93" cy="49" r="1.8" fill="var(--cream)"/></>}</g>
</svg>
