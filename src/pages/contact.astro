---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Spoons from '../components/Spoons.astro';
import FormFields from '../components/FormFields.astro';
import FormScript from '../components/FormScript.astro';
const requestedTopic=Astro.url.searchParams.get('topic')||'';
const topics=['Just saying hello','Product question','Market or event','Order question','Newsletter or privacy request'];
---
<Layout title="Say Hello" description="A question, a kitchen idea, or a local event? Send a note to the father–daughter team behind Two Spoons in Sterling, Virginia."><div class="container"><div class="form-layout"><div class="form-story"><span class="eyebrow">REAL PEOPLE. ON THE OTHER END.</span><h1>Good things start<br/>with <em class="text-orange">“hello.”</em></h1><p>A question about the pantry? An idea for a local event? Or just want to cheer on a dad and daughter with a dream? We’d love to hear from you.</p><ul class="idea-list" style="margin-top:28px"><li><Icon name="pin" size={19}/>Sterling, Virginia</li><li><Icon name="heart" size={19}/>A small family team, with open ears</li></ul><div class="form-story-art" style="background:var(--peach)"><Spoons faces={true}/><p>send a little hello our way.</p></div><p style="font-size:12px">Looking to order? <a class="text-link" href="/order" style="font-size:12px">Start an order request <Icon size={16}/></a></p></div><form class="form-panel" data-kind="contact" method="post" action="/api/contact"><h2>Drop us a note.</h2><p>We’re a small team, so a reply may take a little time.</p><FormFields prefix="contact"/><div class="field"><label for="contact-topic">What’s on your mind?</label><select id="contact-topic" name="topic">{topics.map(topic=><option selected={topic===requestedTopic}>{topic}</option>)}</select></div><div class="field"><label for="contact-message">Your message</label><textarea id="contact-message" name="message" placeholder="Hi, Two Spoons! I’d love to know…" required minlength="20" maxlength="4000" rows="5"></textarea><span class="form-fineprint">At least 20 characters. Please leave out sensitive medical or payment details.</span></div><label class="check-label"><input type="checkbox" name="consent" required/><span>I agree that Two Spoons may use these details to respond to my message, as described in the <a href="/privacy">privacy notice</a>.</span></label><button type="submit" class="button">Send our family a note <Icon name="mail" size={18}/></button><div class="form-message" data-form-message role="status" aria-live="polite" tabindex="-1" hidden></div><noscript><p class="form-message error">Please enable JavaScript to securely submit this form.</p></noscript></form></div></div><FormScript/></Layout>
