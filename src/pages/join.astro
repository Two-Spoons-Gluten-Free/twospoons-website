---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Spoons from '../components/Spoons.astro';
import FormFields from '../components/FormFields.astro';
import FormScript from '../components/FormScript.astro';
---
<Layout title="Newsletter Sign Up" description="Join the Two Spoons newsletter for first-batch news, kitchen stories, and market dates from our father–daughter kitchen."><div class="container"><div class="form-layout"><div class="form-story"><span class="eyebrow">PULL UP A CHAIR</span><h1>Be part of<br/><em class="text-orange">our beginning.</em></h1><p>Something good is stirring in our kitchen, and we’d love to share it with you. Sign up for a little note from the two of us.</p><ul class="idea-list" style="margin-top:27px"><li><Icon name="bag" size={19}/>First-batch and new-product news</li><li><Icon name="heart" size={19}/>Stories from our family kitchen</li><li><Icon name="pin" size={19}/>Market dates and local happenings</li></ul><div class="form-story-art"><Spoons faces={true}/><p>there’s room for you at our table.</p></div></div><form class="form-panel" data-kind="signup" method="post" action="/api/signup"><h2>The good-stuff list.</h2><p>Good food. Family news. A little joy in your inbox.</p><FormFields prefix="signup"/><fieldset><legend>What sounds good? <span style="font-weight:400">(optional)</span></legend><div class="interest-options"><label><input type="checkbox" name="interests" value="chocolate-chip-cookies"/>Chocolate chip cookies</label><label><input type="checkbox" name="interests" value="banana-bread"/>Banana bread</label><label><input type="checkbox" name="interests" value="all-purpose-seasoning"/>All-purpose seasoning</label><label><input type="checkbox" name="interests" value="taco-seasoning"/>Taco seasoning</label><label><input type="checkbox" name="interests" value="cajun-blackening-seasoning"/>Cajun &amp; blackening seasoning</label><label><input type="checkbox" name="interests" value="events"/>Local events</label></div></fieldset><label class="check-label"><input type="checkbox" name="consent" required/><span>Yes, send me Two Spoons news by email. I can ask to leave the list any time. I’ve read the <a href="/privacy">privacy notice</a>.</span></label><button class="button" type="submit">Sign me up <Icon size={18}/></button><p class="form-fineprint">We’ll save your signup for our upcoming newsletter. No account needed.</p><div class="form-message" data-form-message role="status" aria-live="polite" tabindex="-1" hidden></div><noscript><p class="form-message error">Please enable JavaScript to securely submit this form.</p></noscript></form></div></div><FormScript/></Layout>
